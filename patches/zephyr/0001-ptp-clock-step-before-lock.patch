diff --git a/subsys/net/lib/ptp/clock.c b/subsys/net/lib/ptp/clock.c
index 349e8f9e80a..351010e7ea4 100644
--- a/subsys/net/lib/ptp/clock.c
+++ b/subsys/net/lib/ptp/clock.c
@@ -38,7 +38,9 @@ LOG_MODULE_REGISTER(ptp_clock, CONFIG_PTP_LOG_LEVEL);
 
 /*
  * Servo acquisition policy:
- * - offsets above the step threshold are corrected by setting the clock;
+ * - offsets above the step threshold are corrected by setting the clock; until
+ *   the servo has locked, anything above the lock threshold is stepped too, as
+ *   the PI controller cannot slew such offsets without saturating;
  * - three consecutive samples within 10 ms mark the frequency servo as locked;
  * - while locked, offsets above 100 ms are rejected, and two consecutive
  *   outliers reset the servo. The next sample starts acquisition again.
@@ -678,7 +680,7 @@ static __noinline void clock_step(const struct precision_clock *precision_clk,
 	precision_time_t target_time;
 	int ret;
 
-	LOG_WRN_RATELIMIT("Clock offset exceeds 1 second (t1=%" PRIu64 ".%09u t2=%" PRIu64
+	LOG_WRN_RATELIMIT("Clock offset exceeds step threshold (t1=%" PRIu64 ".%09u t2=%" PRIu64
 			  ".%09u delay=%lldns offset=%lldns phc_now=%" PRIu64
 			  ".%09u |t2-phc|=%" PRIu64 "ns)",
 			  ptp_clk.timestamp.t1 / NSEC_PER_SEC,
@@ -771,6 +773,7 @@ static void clock_synchronize_with_delay(uint64_t ingress, uint64_t egress,
 	int64_t offset;
 	int ret;
 	int64_t delay = mean_delay >> 16;
+	int64_t step_threshold;
 	uint64_t phc_now_ns;
 	uint64_t ingress_phc_delta;
 
@@ -801,8 +804,9 @@ static void clock_synchronize_with_delay(uint64_t ingress, uint64_t egress,
 	offset = (int64_t)(ptp_clk.timestamp.t2 - ptp_clk.timestamp.t1) - delay;
 
 	/* If diff is too big, ptp_clk needs to be set first. */
-	if (offset > SYNC_SERVO_STEP_THRESHOLD_NS ||
-	    offset < -SYNC_SERVO_STEP_THRESHOLD_NS) {
+	step_threshold = ptp_clk.sync_servo_locked ? SYNC_SERVO_STEP_THRESHOLD_NS
+						   : SYNC_SERVO_LOCK_OFFSET_NS;
+	if (offset > step_threshold || offset < -step_threshold) {
 		clock_step(precision_clk, current_time, offset, delay, phc_now_ns);
 		return;
 	}
